+
+func TestReporterCancelsWhenRegistrationIsRevoked(t *testing.T) {
+	client := mocks.NewMockClient(t)
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	taskCtx, err := structpb.NewStruct(map[string]any{})
+	require.NoError(t, err)
+	reporter := NewReporter(common.WithDaemonContext(ctx, t.Context()), cancel, client, &runnerv1.Task{Context: taskCtx}, time.Second, &config.Retry{MaxRetries: 3})
+	refusal := connect_go.NewError(connect_go.CodeUnauthenticated, errors.New("unregistered runner"))
+	client.On("UpdateTask", mock.Anything, mock.Anything).Return(nil, refusal).Once()
+	client.On("UpdateLog", mock.Anything, mock.Anything).Return(nil, refusal).Twice()
+	reporter.RunDaemon()
+	require.ErrorIs(t, ctx.Err(), context.Canceled)
+	require.ErrorContains(t, reporter.Close(ctx.Err()), "unregistered runner")
+}
